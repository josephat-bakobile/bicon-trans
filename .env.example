# Copy to .env, fill in real values, and keep it out of git (already in .gitignore).
# Loaded by deploy/bicon-trans.service via EnvironmentFile.

SECRET_KEY=change-me-to-a-long-random-string
SITE_PASSWORD=change-me-login-password
ACTION_CODE=change-me-confirmation-code

# Optional: override where the SQLite file lives (defaults to ./data/bicon_trans.db
# relative to the app's working directory).
# DATABASE_PATH=/home/bicon/Documents/MAGARI/data/bicon_trans.db

# Optional: set to true once the site is served over HTTPS in production, so the
# session cookie is only ever sent over an encrypted connection. Leave unset for
# local http:// development, otherwise the login cookie won't be stored.
# FORCE_HTTPS=true

# Optional: only used for the one-time legacy import; safe to leave unset once
# the database already has data (the import step skips itself automatically).
# LEGACY_XLSX_PATH=/home/bicon/Documents/MAGARI/legacy/MAKUSANYO YA MAGARI - TAKWIMU.xlsx
# Beem Africa SMS (used to text drivers from Makusanyo/Uchambuzi/Huduma). Leave
# unset to disable SMS sending entirely -- "Tuma SMS" buttons will show a
# config-missing error instead of failing silently.
#BULK_SMS_SECRET_KEY=change-me-beem-secret-key
#API_KEY=change-me-beem-api-key
#BEEM_SENDER_ID=change-me-registered-sender-id
